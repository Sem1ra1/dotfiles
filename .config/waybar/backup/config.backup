{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "top",
"position": "top",
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"gtk-layer-shell": true,
"margin-left": 10,
"margin-right": 10,
"margin-top": 5,

"modules-left": [	
	"hyprland/workspaces#rw",
	"group/mobo_drawer",
	"tray",
	"hyprland/window"
//"mpris", 
//"custom/weather",
	],
    
"modules-center": [
  //  "group/app_drawer",
	"clock#2",
  "group/monitors",

],
    
"modules-right": [
  "custom/keyboard",
	"group/notify",
  "network",
	"battery",
  "group/audio",
	"custom/nightlight",
	"custom/power",
	],
}

